
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
  font-family: 'Inter', sans-serif;
  color: #f4f5f8;
  background: #090b10;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #090b10;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

#root {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  text-align: left;
}

.app-shell {
  min-height: 100vh;
  background: #090b10;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 235px;
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  background: #0e1118;
  border-right: 1px solid #20232d;
  z-index: 5;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 55px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  background: #b5fa68;
  color: #11170b;
  border-radius: 11px;
  font-size: 24px;
  font-weight: 900;
}

.brand strong, .brand span,
.sidebar-bottom strong, .sidebar-bottom span {
  display: block;
}

.brand strong {
  font-size: 19px;
  letter-spacing: 2px;
}

.brand span {
  margin-top: 4px;
  color: #7c8495;
  font-size: 9px;
  letter-spacing: 1.5px;
}

.nav-label, .eyebrow {
  color: #8a93a4;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.nav-label {
  margin: 0 0 15px 8px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 13px;
  width: 100%;
  padding: 14px 12px;
  margin-bottom: 7px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #a7adbb;
  text-align: left;
  font-size: 13px;
}

.nav-item.active {
  color: #c0ff80;
  background: #1a2417;
  border-color: #2d4022;
}

.sidebar-bottom {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: auto;
  padding: 15px 5px 0;
  border-top: 1px solid #252934;
}

.connection-dot, .demo-badge span {
  width: 7px;
  height: 7px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #a8f45f;
}

.sidebar-bottom strong {
  font-size: 11px;
}

.sidebar-bottom span {
  margin-top: 5px;
  color: #777f90;
  font-size: 10px;
}

.main-content {
  width: calc(100% - 235px);
  max-width: 1600px;
  margin-left: 235px;
  padding: 0 42px;
}

.topbar {
  height: 75px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #20232d;
}

.breadcrumb {
  color: #cbd0da;
  font-size: 12px;
}

.breadcrumb span {
  margin: 0 10px;
  color: #636b7a;
}

.demo-badge {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 9px 12px;
  border: 1px solid #30372b;
  border-radius: 5px;
  color: #c2f99a;
  font-size: 9px;
  letter-spacing: 1px;
}

.welcome {
  min-height: 290px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 35px 0;
}

.welcome h1 {
  margin: 17px 0 12px;
  font-size: clamp(34px, 4vw, 55px);
  line-height: 1.08;
  letter-spacing: -2px;
}

.welcome h1 span {
  color: #b6fa6b;
}

.welcome p {
  max-width: 440px;
  color: #929aab;
  font-size: 13px;
  line-height: 1.8;
}

.primary-button {
  margin-top: 15px;
  padding: 13px 17px;
  border: 0;
  border-radius: 6px;
  background: #b6fa6b;
  color: #10150b;
  font-size: 11px;
  font-weight: 800;
}

.primary-button span {
  margin-left: 10px;
  font-size: 15px;
}

.hero-graphic {
  position: relative;
  width: 220px;
  height: 220px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
}

.orbit {
  position: absolute;
  border: 1px solid #333d2b;
  border-radius: 50%;
}

.orbit-one {
  width: 210px;
  height: 210px;
}

.orbit-two {
  width: 155px;
  height: 155px;
  border-color: #4c6339;
}

.hero-symbol {
  width: 100px;
  height: 100px;
  display: grid;
  place-items: center;
  border-radius: 25px;
  background: linear-gradient(135deg, #c9ff8e, #7ab943);
  color: #18220e;
  font-size: 66px;
  font-weight: 900;
  box-shadow: 0 0 70px #a5ef5030;
  transform: rotate(-8deg);
}

.graphic-caption {
  position: absolute;
  bottom: -4px;
  color: #7d8797;
  font-size: 9px;
  letter-spacing: 1.5px;
}

.graphic-caption span {
  color: #b6fa6b;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 48px;
}

.stat-card {
  min-width: 0;
  padding: 20px;
  background: #11141c;
  border: 1px solid #252936;
  border-radius: 10px;
}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  color: #929aab;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .7px;
}

.stat-icon {
  color: #b6fa6b;
  font-size: 18px;
}

.stat-value {
  margin-top: 22px;
  font-size: clamp(20px, 2vw, 30px);
  font-weight: 800;
  overflow-wrap: anywhere;
}

.stat-note {
  margin-top: 9px;
  color: #7d8595;
  font-size: 10px;
  line-height: 1.6;
}

.highlight-card {
  border-color: #35452b;
  background: linear-gradient(145deg, #171e15, #11141c);
}

.highlight-card .stat-value {
  font-size: 18px;
}

.locker-section {
  padding-bottom: 45px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.section-heading h2 {
  margin: 10px 0 0;
  font-size: 23px;
  letter-spacing: -.6px;
}

.item-count {
  color: #8b94a5;
  font-size: 11px;
}

.catalog-search {
  display: block;
  width: 100%;
  max-width: 460px;
  margin: 0 0 20px;
  padding: 13px 15px;
  border: 1px solid #292e3a;
  border-radius: 7px;
  background: #10131b;
  color: #f1f3f8;
  font-size: 12px;
  outline: none;
}

.catalog-search:focus {
  border-color: #a5f35a;
}

.catalog-search::placeholder {
  color: #727b8b;
}

.filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 23px;
}

.filter {
  padding: 9px 13px;
  border: 1px solid #292e3a;
  border-radius: 6px;
  background: #11141c;
  color: #a5adbb;
  font-size: 10px;
}

.active-filter {
  border-color: #b6fa6b;
  background: #b6fa6b;
  color: #10150b;
  font-weight: 800;
}

.cosmetic-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.cosmetic-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #282d39;
  border-radius: 9px;
  background: #11141c;
  transition: transform .2s, border-color .2s;
}

.cosmetic-card:hover {
  transform: translateY(-3px);
  border-color: #6c8a4c;
}

.cosmetic-art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: radial-gradient(circle at 50% 35%, #303b2b, #191d25 70%);
}

.cosmetic-art img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 8px;
  object-fit: contain;
}

.rarity {
  position: absolute;
  z-index: 2;
  left: 9px;
  bottom: 9px;
  padding: 5px 7px;
  border: 1px solid #ffffff20;
  border-radius: 4px;
  background: #090b10cc;
  color: #dce2eb;
  font-size: 9px;
}

.art-initial {
  color: #b6fa6b;
  font-size: 54px;
  font-weight: 900;
}

.cosmetic-info {
  padding: 13px;
}

.cosmetic-type {
  display: block;
  margin-bottom: 7px;
  color: #b6fa6b;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .8px;
}

.cosmetic-info strong {
  display: block;
  min-height: 34px;
  font-size: 12px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.item-score {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #292e39;
  color: #828b9c;
  font-size: 10px;
}

.error-message {
  margin: 20px 0;
  padding: 18px;
  border: 1px solid #713c3c;
  border-radius: 8px;
  background: #211416;
  color: #f2aaaa;
  font-size: 12px;
}

.status-message, .disclaimer {
  color: #929aab;
  font-size: 12px;
  line-height: 1.8;
}

.disclaimer {
  margin-top: 22px;
}

.primary-button:disabled {
  opacity: .6;
  cursor: wait;
}

footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 20px 0;
  border-top: 1px solid #20232d;
  color: #737c8d;
  font-size: 10px;
}

@media (max-width: 1150px) {
  .main-content {
    padding: 0 25px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cosmetic-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero-graphic {
    width: 170px;
    transform: scale(.85);
  }
}

@media (max-width: 760px) {
  .sidebar {
    position: relative;
    width: 100%;
    height: auto;
    padding: 15px 20px;
    border-right: 0;
    border-bottom: 1px solid #20232d;
  }

  .brand {
    margin-bottom: 15px;
  }

  .nav-label, .sidebar-bottom {
    display: none;
  }

  .nav-item {
    display: inline-flex;
    width: auto;
    margin: 0 5px 0 0;
    padding: 10px;
  }

  .main-content {
    width: 100%;
    margin-left: 0;
    padding: 0 17px;
  }

  .topbar {
    height: 58px;
  }

  .welcome {
    min-height: auto;
    padding: 40px 0;
  }

  .welcome h1 {
    font-size: 37px;
  }

  .welcome p {
    font-size: 12px;
  }

  .hero-graphic {
    display: none;
  }

  .stats-grid {
    gap: 10px;
    margin-bottom: 38px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-top {
    font-size: 8px;
  }

  .stat-value {
    font-size: 22px;
  }

  .cosmetic-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .section-heading h2 {
    font-size: 19px;
  }

  footer {
    flex-direction: column;
  }
}

/* ===== LOCKR — amélioration visuelle ===== */

button,
input,
select {
  font: inherit;
}

button {
  transition:
    background-color 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease,
    opacity 0.18s ease;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid #b6fa6b;
  outline-offset: 3px;
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.nav-item:hover:not(.active) {
  background: #171b24;
  color: #f4f5f8;
}

.primary-button {
  box-shadow: 0 4px 18px #b6fa6b15;
}

.primary-button:hover:not(:disabled) {
  background: #c8ff91;
  transform: translateY(-1px);
  box-shadow: 0 6px 24px #b6fa6b25;
}

.catalog-search,
.filters select {
  min-height: 43px;
  border: 1px solid #292e3a;
  border-radius: 8px;
  background-color: #10131b;
  color: #f4f5f8;
}

.catalog-search {
  max-width: 100%;
}

.catalog-search:focus,
.filters select:focus {
  border-color: #b6fa6b;
}

.filters select {
  max-width: 100%;
  padding: 10px 34px 10px 12px;
  font-size: 12px;
  cursor: pointer;
}

.filters select option {
  background: #11141c;
  color: #f4f5f8;
}

.filter {
  min-height: 34px;
}

.filter:hover:not(.active-filter) {
  border-color: #6c8a4c;
  background: #1a2018;
  color: #e7f7d9;
}

.active-filter:hover {
  background: #c8ff91;
}

.cosmetic-card {
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 16px #00000010;
}

.cosmetic-card:hover {
  box-shadow: 0 12px 30px #00000030;
}

.cosmetic-art {
  isolation: isolate;
}

.cosmetic-art img {
  transition: transform 0.25s ease;
}

.cosmetic-card:hover .cosmetic-art img {
  transform: scale(1.045);
}

.cosmetic-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: stretch;
}

.cosmetic-info > strong {
  margin-bottom: 12px;
}

.cosmetic-info > button {
  width: 100%;
  margin-top: auto;
}

.item-score {
  overflow-wrap: anywhere;
}

.stat-card {
  transition: border-color 0.2s ease;
}

.stat-card:hover {
  border-color: #3a4433;
}

.error-message button {
  margin-top: 8px;
}

@media (max-width: 760px) {
  .filters {
    gap: 8px;
  }

  .filters select {
    flex: 1 1 145px;
    min-width: 0;
  }

  .catalog-search {
    width: 100%;
  }

  .cosmetic-info {
    padding: 11px;
  }

  .cosmetic-info > strong {
    font-size: 11px;
  }

  .cosmetic-info > button {
    padding: 9px 6px;
    font-size: 10px;
  }

  .welcome h1 {
    letter-spacing: -1.5px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

.favorite-button {
  position: absolute;
  z-index: 3;
  top: 10px;
  right: 10px;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid #ffffff26;
  border-radius: 50%;
  background: #090b10dd;
  color: #f4f5f8;
  font-size: 23px;
  line-height: 1;
}

.favorite-button:hover,
.favorite-button.is-favorite {
  border-color: #b6fa6b;
  color: #b6fa6b;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
  margin: 28px 0;
  color: #b7becc;
  font-size: 12px;
}

.pagination button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.locker-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 24px;
}

.locker-summary > div {
  display: flex;
  flex-direction: column;
  gap: 9px;
  min-width: 0;
  padding: 17px;
  border: 1px solid #2a303b;
  border-radius: 9px;
  background: #11141c;
}

.locker-summary span {
  color: #8f98a9;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.locker-summary strong {
  color: #b6fa6b;
  font-size: 18px;
  overflow-wrap: anywhere;
}

.account-panel,
.account-form {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16px;
  max-width: 620px;
  padding: 22px;
  border: 1px solid #282e3a;
  border-radius: 12px;
  background: #11141c;
}

.account-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #b7becc;
  font-size: 12px;
  font-weight: 600;
}

.account-form input,
.account-form select {
  width: 100%;
  min-height: 44px;
  padding: 11px 13px;
  border: 1px solid #303644;
  border-radius: 7px;
  outline: none;
  background: #090c12;
  color: #f4f5f8;
  font-size: 13px;
}

.account-form input:focus,
.account-form select:focus {
  border-color: #b6fa6b;
}

.account-form .primary-button {
  align-self: flex-start;
  margin-top: 0;
}

.auth-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.account-form .disclaimer {
  margin: 0;
}

.leaderboard {
  overflow-x: auto;
  border: 1px solid #292f3b;
  border-radius: 10px;
  background: #11141c;
}

.leaderboard-row {
  display: grid;
  grid-template-columns: 55px minmax(120px, 1.6fr) minmax(90px, 1fr) 65px 90px 75px;
  align-items: center;
  gap: 12px;
  min-width: 620px;
  padding: 15px 17px;
  border-bottom: 1px solid #272c37;
  color: #dce1eb;
  font-size: 12px;
}

.leaderboard-row:last-child {
  border-bottom: 0;
}

.leaderboard-row:not(.leaderboard-header):hover {
  background: #191f19;
}

.leaderboard-header {
  background: #171b24;
  color: #8993a5;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.leaderboard-rank {
  color: #b6fa6b;
  font-weight: 800;
}

.leaderboard-row strong {
  overflow-wrap: anywhere;
}

.grade-pill {
  font-weight: 900;
}

.collection-stats {
  margin-bottom: 45px;
}

.account-panel > .filter {
  align-self: flex-start;
}

@media (max-width: 760px) {
  .locker-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .locker-summary > div {
    padding: 14px;
  }

  .locker-summary > div:last-child {
    grid-column: 1 / -1;
  }

  .account-form,
  .account-panel {
    padding: 16px;
  }

  .pagination {
    gap: 8px;
  }

  .pagination button {
    padding: 9px;
  }

  .favorite-button {
    top: 7px;
    right: 7px;
    width: 32px;
    height: 32px;
  }
}

@media (max-width: 760px) {
  .sidebar {
    position: fixed;
    inset: auto 0 0;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2px;
    width: 100%;
    height: auto;
    padding: 7px 8px calc(7px + env(safe-area-inset-bottom));
    background: #0e1118f5;
    border: 0;
    border-top: 1px solid #20232d;
    backdrop-filter: blur(14px);
  }

  .brand,
  .nav-label,
  .sidebar-bottom {
    display: none;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    min-height: 52px;
    margin: 0;
    padding: 5px 2px;
    border-radius: 8px;
    text-align: center;
    font-size: 16px;
    line-height: 1;
  }

  .nav-item span {
    max-width: 100%;
    overflow: hidden;
    font-size: 9px;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .main-content {
    padding-bottom: calc(78px + env(safe-area-inset-bottom));
  }

  .topbar {
    gap: 10px;
  }

  .demo-badge {
    flex-shrink: 0;
    padding: 8px;
    font-size: 8px;
  }

  .filter,
  .filters select,
  .pagination button,
  .cosmetic-info > button,
  .account-form .primary-button,
  .account-panel > button {
    min-height: 44px;
  }

  .filters {
    gap: 8px;
  }

  .favorite-button {
    width: 44px;
    height: 44px;
  }

  .account-form .primary-button {
    align-self: stretch;
  }
}

@media (max-width: 380px) {
  .main-content {
    padding-right: 13px;
    padding-left: 13px;
  }

  .stat-card {
    padding: 11px;
  }

  .stat-top {
    font-size: 7px;
    letter-spacing: 0.4px;
  }

  .section-heading {
    align-items: flex-start;
  }
}
